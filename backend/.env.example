# Optional. The default already matches the usual Windows Tesseract install.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional SQLite location.
# WALLETWISE_DB_PATH=C:\path\to\walletwise.db

# WalletWise AI (Groq)
# Create a key at https://console.groq.com/keys, copy this file to .env,
# and paste the key below. Never put this key in frontend/.env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions


# Hybrid Wally answers factual questions locally (0 AI tokens).
# For AI-assisted questions, keep structured answers concise.
WALLETWISE_AI_MAX_COMPLETION_TOKENS=1400
# One automatic retry only when structured JSON is truncated.
WALLETWISE_AI_RETRY_COMPLETION_TOKENS=2000

# Wally semantic routing / unified terminal trace
# High-confidence deterministic questions stay local. Ambiguous wording can use
# a tiny AI query-planner request containing NO financial dataset.
WALLETWISE_ROUTER_AI_ENABLED=true
WALLETWISE_ROUTER_MAX_TOKENS=320
WALLETWISE_ROUTER_CONFIDENCE_THRESHOLD=0.78
# Optional: choose a separate model for tiny routing requests.
# GROQ_ROUTER_MODEL=openai/gpt-oss-120b

# One unified trace only: frontend request -> semantic plan -> validation ->
# local/AI execution -> answer validation -> frontend response.
# API keys / Authorization headers are never printed.
WALLETWISE_TRACE=true

# Optional FNB import diagnostics (OFF by default to avoid storing copies of PDFs).
# When true, debug PDFs and date-resolution JSON are saved locally under
# backend/data/debug/; these debug PDFs contain sensitive statement information.
WALLETWISE_IMPORT_DEBUG=0
